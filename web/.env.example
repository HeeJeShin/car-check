# API 서버 주소 (car-check/api). 기본값이 이 값이라 그대로 두면 됩니다.
NEXT_PUBLIC_API_URL=http://localhost:3200

# Sentry(에러 수집) Next.js 프로젝트의 DSN. 비우면 안 보냄. (브라우저에 들어가는 공개 값)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# 배포 빌드 때 소스맵 업로드용 (Vercel 환경변수에만). 없으면 업로드 안 함.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# 검색엔진용 사이트 주소 (sitemap.xml·robots.txt·대표 주소). 비우면 https://car-check-fawn-zeta.vercel.app
NEXT_PUBLIC_SITE_URL=""
# 검색엔진 소유 확인 코드 (네이버 서치어드바이저·구글 서치 콘솔에서 받은 값). 비우면 안 붙임
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
