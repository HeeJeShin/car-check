# API 서버 주소 (car-check/api). 기본값이 이 값이라 그대로 두면 됩니다.
NEXT_PUBLIC_API_URL=http://localhost:3200

# Sentry(에러 수집) Next.js 프로젝트의 DSN. 비우면 안 보냄. (브라우저에 들어가는 공개 값)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
# 배포 빌드 때 소스맵 업로드용 (Vercel 환경변수에만). 없으면 업로드 안 함.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
