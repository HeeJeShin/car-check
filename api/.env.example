# 이 파일을 .env로 복사해서 쓰세요. (.env는 git에 올라가지 않습니다)
DATABASE_URL="postgresql://car:car@localhost:5434/car_check?schema=public"
PORT=3200

# ── AI(Gemini) 설정: 셋 다 비워두면 AI 없이 실행됩니다(차종 검색·고질병·관리 화면은 정상 동작) ──
# https://aistudio.google.com 에서 무료 발급
GEMINI_API_KEY=""
# 비우면 gemini-flash-latest(최신 Flash 별칭)를 씁니다.
GEMINI_MODEL=""
# true면 키 없이 미리 준비된 샘플 답변으로 AI 화면을 확인합니다. 비용·할당량 0.
USE_MOCK_AI=false
# 서버 전체에서 1분에 Gemini를 부를 수 있는 횟수 (비우면 10). 쓰는 모델의 무료 등급 분당 한도보다 조금 낮게.
# 같은 질문은 하루 동안 캐시된 답을 쓰므로 횟수에 안 들어갑니다. IP별 한도(1분 5번·하루 30번)는 ai.service.ts의 AI_LIMITS.
AI_GLOBAL_PER_MIN=""

# ── 관리 화면 로그인 ──
# 구글 Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
#   승인된 JavaScript 원본에 http://localhost:3201 추가. 발급된 "클라이언트 ID"만 넣으면 됩니다(비밀번호는 필요 없음).
GOOGLE_CLIENT_ID=""
# 관리 권한을 줄 구글 이메일 (쉼표로 여러 개). 목록에 없는 계정은 로그인할 수 없습니다.
ADMIN_EMAILS=""   # 모든 수정 + 검증됨 처리 + 삭제
EDITOR_EMAILS=""  # 초안 작성·수정만
# 로그인 토큰 서명용 비밀키. 비우면 개발 중에는 임시 키(서버 재시작 시 로그아웃), 운영에서는 필수.
#   만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=""
# true면 구글 설정 없이 이메일만으로 로그인(개발·테스트용). 운영 환경(NODE_ENV=production)에서는 항상 꺼짐.
AUTH_DEV_LOGIN=true
# 화면 주소 (CORS). 배포하면 실제 주소로.
WEB_ORIGIN="http://localhost:3201"

# ── 배포 환경 ──
# Neon처럼 연결 풀 주소(DATABASE_URL)와 직접 주소가 따로 있으면 마이그레이션용 직접 주소. 로컬은 비워둠.
DIRECT_URL=""
# 프록시(Render 등) 뒤에서 실제 사용자 IP를 쓰려면 1. 로컬은 비워둠.
TRUST_PROXY=""
# Sentry(에러 수집) NestJS 프로젝트의 DSN. 비우면 안 보냄.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
