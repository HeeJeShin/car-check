// ─────────────────────────────────────────────────────────────
// DB 스키마. 고치고 나서 `pnpm db:migrate` → 마이그레이션 생성 + DB 반영 + 타입 재생성.
//
// ⭐ 이 서비스의 핵심 데이터는 "사람이 검증한 고질병 정보"입니다.
//    AI가 기억으로 지어내지 않도록, 고질병은 전부 이 DB에서만 나옵니다.
//
// 화면 흐름(기획): 차종 이름 고르기 → 세대·연식 고르기 → 고질병 리포트 → 매장 점검 가이드
// ─────────────────────────────────────────────────────────────

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS는 CommonJS로 돌기 때문에 생성 코드도 CJS로 맞춥니다. (Prisma 7 기본값은 ESM)
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 차종의 "세대" 하나 = 행 하나. (예: 현대 투싼 TL "올 뉴 투싼", 2015~2018)
// ⚠️ 연식만으로는 차를 특정할 수 없습니다. 같은 2015년식 투싼도 구형과 신형이 있고
//    세대(페이스리프트 포함)가 다르면 고질병도 다릅니다. 그래서 세대 단위로 저장합니다.
model CarModel {
  id               Int               @id @default(autoincrement())
  maker            String // 현대, 기아, BMW ...
  name             String // 투싼, 5시리즈 ... → "차종 선택" 화면의 카드 하나
  // 사람들이 실제로 부르는 세대 이름. "세대·연식 선택" 화면에 "올 뉴 투싼 (2015~2018)"처럼 보입니다.
  displayName      String
  generation       String // TL, F10 같은 세대 코드 (보조 정보)
  segment          String? // 차급: "준중형 SUV" (차종 카드의 작은 글씨)
  bodyType         BodyType // 차종 선택 화면의 SUV·세단·경차 필터
  yearFrom         Int
  yearTo           Int? // null = 현재 판매 중
  // 검색용 별칭(소문자, 공백 없음). "올뉴투싼", "tucson", "520d"처럼 사람들이 실제로 치는 이름.
  aliases          String[]
  powertrains      Powertrain[]
  issues           CarIssue[]
  inspectionPoints InspectionPoint[]
  createdAt        DateTime          @default(now())

  @@index([maker, name])
}

// 차 종류. 경차는 크기 기준(경차 혜택)이라 캐스퍼처럼 SUV 모양이어도 LIGHT로 둡니다.
enum BodyType {
  SEDAN // 세단
  SUV
  LIGHT // 경차
  VAN // 승합·미니밴
}

enum Fuel {
  GASOLINE
  DIESEL
  LPG
  HYBRID
  EV
}

enum Transmission {
  AT // 일반 자동(토크컨버터)
  DCT // 듀얼 클러치
  CVT // 무단 변속
  MT // 수동
  REDUCER // 전기차 1단 감속기 (변속 없음)
}

// 한 세대에도 엔진·미션 조합이 여러 개입니다. (예: 1.7 디젤+DCT, 2.0 디젤+자동)
// 미션·연료 종류만 넣으면 "DCT → 저속 꿀렁거림 확인" 같은 주의점이 공통 규칙으로 자동으로 붙습니다.
model Powertrain {
  id           Int          @id @default(autoincrement())
  carModel     CarModel     @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  carModelId   Int
  engine       String // "1.7 디젤"
  fuel         Fuel
  transmission Transmission
  gearbox      String? // "7단 DCT" 같은 상세 표기
  drive        String? // "2WD", "4WD"

  @@index([carModelId])
}

enum IssueStatus {
  DRAFT // 초안: 확인 전. 화면에 "참고"로 표시
  VERIFIED // 검증됨: 직접 출처를 확인함
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

// 고질병·주의사항 1건 = 행 하나
model CarIssue {
  id          Int         @id @default(autoincrement())
  carModel    CarModel    @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  carModelId  Int
  engine      String? // 해당 엔진만 문제일 때 (예: "1.7 디젤"). null = 전 엔진 공통
  part        String // 엔진, 변속기, 전장, 하체, 차체, 기타
  title       String
  description String
  // 중고차를 살 때 "무엇을 어떻게 확인하라"는 실전 팁. 이 서비스가 주는 핵심 가치.
  checkHow    String
  severity    Severity    @default(MEDIUM)
  status      IssueStatus @default(DRAFT)
  sourceUrl   String? // 검증할 때 확인한 출처
  note        String? // 출처 메모, 확인할 점 등
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([carModelId])
}

// "본넷 열고 볼 곳" 그림 위의 빨간 동그라미 하나.
// carModelId가 null이면 모든 차 공통(엔진오일, 냉각수 …), 있으면 그 차만의 포인트(점선 동그라미).
// x, y는 그림 크기에 대한 퍼센트(0~100). 그림을 실제 사진으로 바꿔도 좌표만 고치면 됩니다.
model InspectionPoint {
  id         Int       @id @default(autoincrement())
  carModel   CarModel? @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  carModelId Int?
  order      Int // 그림에 찍히는 번호 순서
  x          Float
  y          Float
  title      String
  look       String // 보는 법
  bad        String // 이러면 주의
  // 엔진오일·벨트처럼 내연기관에만 있는 곳. 전기차 점검 가이드에서는 빼고 보여줍니다.
  iceOnly    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([carModelId])
}

// ── 로그인 ──
// 관리 화면에 구글 계정으로 로그인한 사람. 역할은 .env의 ADMIN_EMAILS·EDITOR_EMAILS로 정하고 로그인할 때마다 맞춥니다.
// (나중에 고질병 변경 이력에 "누가 바꿨는지"를 남길 때 이 id를 씁니다)
enum Role {
  ADMIN // 모든 수정 + "검증됨" 처리 + 삭제
  EDITOR // 초안 작성·수정만. "검증됨"으로 바꾸거나 검증된 정보를 고칠 수 없음
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String
  picture     String?
  role        Role
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
}
