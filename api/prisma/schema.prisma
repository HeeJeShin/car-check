// ─────────────────────────────────────────────────────────────
// DB 스키마. 고치고 나서 `pnpm db:migrate` → 마이그레이션 생성 + DB 반영 + 타입 재생성.
//
// ⭐ 이 서비스의 핵심 데이터는 "사람이 검증한 고질병 정보"입니다.
//    AI가 기억으로 지어내지 않도록, 고질병은 전부 이 DB에서만 나옵니다.
// ─────────────────────────────────────────────────────────────

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS는 CommonJS로 돌기 때문에 생성 코드도 CJS로 맞춥니다. (Prisma 7 기본값은 ESM)
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 차종의 "세대" 하나 = 행 하나. (예: 현대 투싼 TL, 2015~2020)
// ⚠️ 연식만으로는 차를 특정할 수 없습니다. 같은 2015년식 투싼도 구형(ix35)과 신형(TL)이 있고
//    세대가 다르면 고질병도 다릅니다. 그래서 세대 단위로 저장합니다.
model CarModel {
  id         Int        @id @default(autoincrement())
  maker      String // 현대, 기아, BMW ...
  name       String // 투싼, 5시리즈 ...
  generation String // TL, F10 같은 세대 코드
  yearFrom   Int
  yearTo     Int? // null = 현재 판매 중
  // 검색용 별칭(소문자). "올뉴투싼", "tucson", "520d"처럼 사람들이 실제로 치는 이름.
  aliases    String[]
  issues     CarIssue[]
  createdAt  DateTime   @default(now())

  @@index([name])
}

enum IssueStatus {
  DRAFT // 초안: 확인 전. 화면에 "참고용"으로 표시
  VERIFIED // 검증됨: 직접 출처를 확인함
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

// 고질병·주의사항 1건 = 행 하나
model CarIssue {
  id          Int         @id @default(autoincrement())
  carModel    CarModel    @relation(fields: [carModelId], references: [id], onDelete: Cascade)
  carModelId  Int
  engine      String? // 해당 엔진만 문제일 때 (예: "1.7 디젤"). null = 전 엔진 공통
  part        String // 엔진, 변속기, 전장, 하체, 차체, 기타
  title       String
  description String
  // 중고차를 살 때 "무엇을 어떻게 확인하라"는 실전 팁. 이 서비스가 주는 핵심 가치.
  checkHow    String
  severity    Severity    @default(MEDIUM)
  status      IssueStatus @default(DRAFT)
  sourceUrl   String? // 검증할 때 확인한 출처
  note        String? // 출처 메모, 확인할 점 등
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([carModelId])
}
